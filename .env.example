# ── Obligatoire ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://...
ADMIN_PASSWORD=motdepasse_a_changer
JWT_SECRET=une_longue_cle_secrete_aleatoire
PORT=3001

# Origine(s) autorisée(s) à appeler l'API. Plusieurs valeurs possibles, séparées
# par des virgules. La variante www/apex de chacune est ajoutée automatiquement.
FRONTEND_URL=https://mathilde-kinesio.fr

# ── Notifications push (APNs) ─────────────────────────────────────────────────
APN_KEY=contenu_du_fichier_p8
APN_KEY_ID=
APN_TEAM_ID=
APN_BUNDLE_ID=com.alequilibre.mathilde
APN_PRODUCTION=false

# ── Bons cadeaux : paiement (Stripe) ──────────────────────────────────────────
# Dashboard Stripe > Développeurs > Clés API
STRIPE_SECRET_KEY=sk_test_...
# Dashboard Stripe > Développeurs > Webhooks, après création du point de
# terminaison /api/stripe/webhook (événements checkout.session.completed
# ET checkout.session.async_payment_succeeded)
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Bons cadeaux : envoi du code par email (EmailJS) ──────────────────────────
# Sans ces variables, l'acheteur ne reçoit PAS son code : le serveur bascule
# alors sur une notification push d'alerte pour un envoi manuel.
# Les appels hors navigateur exigent d'activer, dans EmailJS :
#   Account > Security > « Allow EmailJS API for non-browser applications »
EMAILJS_SERVICE_ID=service_0l2cbri
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_TEMPLATE_GIFT=template_cadeau

# ── Conservation des données (RGPD) ───────────────────────────────────────────
# Applique l'engagement de la politique de confidentialité : anonymisation
# après 3 ans sans contact. Mettre à false pour désactiver la purge.
DATA_RETENTION_ENABLED=true
DATA_RETENTION_YEARS=3
